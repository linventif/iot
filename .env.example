# Database credentials
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=auto_pool_pump
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_HOST=db

# Published host port for MariaDB (host:container)
MYSQL_PUBLIC_PORT=3307
MYSQL_CONTAINER_PORT=3306

# MariaDB port used by API container to reach DB service
MYSQL_API_PORT=3306

# API port mapping (host:container)
API_PUBLIC_PORT=4001
API_CONTAINER_PORT=4001

# Optional Cloudflared token mode (recommended in Docker deployments)
# If empty, cloudflared will fallback to /etc/cloudflared/config.yml mode.
CLOUDFLARED_TOKEN=

# Optional app-level connection URL (mainly for local tooling)
DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3307/auto_pool_pump
